 Thermal::Thermal(const std::shared_ptr<ThermalHelper> &helper) {
     thermal_helper_ = helper;
 }
 
+Thermal::~Thermal() {
+    stopConfigWatcher();
+}
+
+std::shared_ptr<ThermalHelper> Thermal::getThermalHelper() const {
+    std::shared_lock<std::shared_mutex> lock(thermal_helper_mutex_);
+    return thermal_helper_;
+}
+
+std::string Thermal::readThermalConfigProperty() const {
+    std::string value = ::android::base::GetProperty(kConfigProperty.data(),
+                                                     kConfigDefaultFileName.data());
+    value = ::android::base::Trim(value);
+    return value.empty() ? std::string(kConfigDefaultFileName.data()) : value;
+}
+
+void Thermal::startConfigWatcher() {
+    config_watcher_running_ = true;
+    config_watcher_thread_ = std::thread([this] { configWatcherLoop(); });
+}
+
+void Thermal::stopConfigWatcher() {
+    if (!config_watcher_running_.exchange(false)) {
+        return;
+    }
+    if (config_watcher_thread_.joinable()) {
+        config_watcher_thread_.join();
+    }
+}
+
+void Thermal::configWatcherLoop() {
+    while (config_watcher_running_) {
+        std::this_thread::sleep_for(kConfigPollInterval);
+        if (!config_watcher_running_) {
+            break;
+        }
+
+        const std::string current_config_property = readThermalConfigProperty();
+        if (current_config_property == last_config_property_) {
+            pending_config_property_.clear();
+            continue;
+        }
+
+        const auto now = std::chrono::steady_clock::now();
+        if (current_config_property == pending_config_property_ &&
+            now - last_pending_config_check_ < kMissingConfigRetryInterval) {
+            continue;
+        }
+
+        std::string loaded_config_property;
+        if (reloadThermalHelper(current_config_property, &loaded_config_property)) {
+            last_config_property_ = loaded_config_property.empty() ? current_config_property
+                                                                   : loaded_config_property;
+            if (last_config_property_ == current_config_property) {
+                pending_config_property_.clear();
+            } else {
+                pending_config_property_ = current_config_property;
+                last_pending_config_check_ = now;
+            }
+        } else {
+            pending_config_property_ = current_config_property;
+            last_pending_config_check_ = now;
+        }
+    }
+}
+
+bool Thermal::reloadThermalHelper(const std::string &config_property,
+                                  std::string *loaded_config_property) {
+    LOG(INFO) << "Reloading Thermal HAL config from " << kConfigProperty.data() << "="
+              << config_property;
+    auto new_helper = std::make_shared<ThermalHelperImpl>(
+            std::bind(&Thermal::sendThermalChangedCallback, this, std::placeholders::_1), false,
+            false);
+    if (!new_helper->isInitializedOk()) {
+        LOG(ERROR) << "New thermal config failed to initialize; keeping previous helper";
+        return false;
+    }
+    const std::string loaded_property = new_helper->getLoadedConfigProperty();
+    if (loaded_config_property != nullptr) {
+        *loaded_config_property = loaded_property;
+    }
+    if (loaded_property != config_property) {
+        LOG(WARNING) << "Thermal config " << config_property << " is pending; using "
+                     << loaded_property << " until it becomes available";
+        if (loaded_property == last_config_property_) {
+            return true;
+        }
+    }
+
+    std::shared_ptr<ThermalHelper> old_helper;
+    {
+        std::unique_lock<std::shared_mutex> lock(thermal_helper_mutex_);
+        old_helper = thermal_helper_;
+        if (old_helper) {
+            old_helper->clearCurrentThrottling();
+        }
+        thermal_helper_ = new_helper;
+    }
+
+    if (!new_helper->startWatcher()) {
+        LOG(ERROR) << "New thermal helper failed to start watcher";
+        std::unique_lock<std::shared_mutex> lock(thermal_helper_mutex_);
+        thermal_helper_ = old_helper;
+        return false;
+    }
+    return true;
+}

// PixelExtraParts thermal HAL fork (FORK via overrides:).
// Builds the mod-channel thermal service (vendor.pixelparts.thermal.config)
// from sources vendored in this directory and вытесняет the stock
// android.hardware.thermal-service.pixel from the image. No file under
// hardware/google/pixel is touched.

soong_namespace {
    imports: [
        "hardware/google/interfaces",
        "hardware/google/pixel/pixelstats",
    ],
}

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.thermal-service.pixel.pep",
    // NOTE: intentionally NO stem: and NO same-name output. Soong emits
    // install/symbols edges for every in-scope module regardless of
    // PRODUCT_PACKAGES, so sharing the stock output path is a fatal
    // "multiple rules" at ninja load. overrides: keeps make-side sane.
    //
    // The stock VINTF fragment is overridden HERE (not on the pep
    // vintf_fragment module): fsgen/removeOverriddenDeps collects Overrides
    // only from modules in the filesystem install set, and vintf fragments
    // pulled via vintf_fragment_modules never enter that set -- so an
    // overrides: on the pep fragment is silently ignored and the stock xml
    // stays in the image (VINTF dup IThermal/default). The cc_binary IS in
    // PRODUCT_PACKAGES, so its override strings are honored and the stock
    // prebuilt_etc_xml is dropped at install-set assembly. Overrides match
    // by plain module name, cross-type is legal.
    overrides: [
        "android.hardware.thermal-service.pixel",
        "android.hardware.thermal-service.pixel.xml",
        "thermal-budget-interface-ndk",
    ],
    srcs: [
        // Build-time generated (//packages/apps/PixelExtraParts/soong/weave_gen):
        // live vanilla + soong/weave/specs, see device.mk regen stanza.
        ":pixelparts_weave_thermal",
    ],
    vendor: true,
    relative_install_path: "hw",
    // Regen mirror (device.mk runs weave_apply.py before Soong parse):
    // filegroup srcs live under soong/weave_gen/, NOT under this directory, so
    // the implicit -I<module dir> doesn't cover them. Mirror the stock
    // layout explicitly so root-relative quotes like
    // "virtualtemp_estimator/virtualtemp_estimator.h" (utils/thermal_info.h)
    // resolve exactly as in hardware/google/pixel/thermal.
    include_dirs: [
        "packages/apps/PixelExtraParts/soong/weave_gen/hardware/google/pixel/thermal",
    ],
    vintf_fragment_modules: [
        "android.hardware.thermal-service.pixel.pep.xml",
    ],
    init_rc: [
        "android.hardware.thermal-service.pixel.pep.rc",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "libjsoncpp",
        "libutils",
        "libnl",
        "libbinder_ndk",
        "android.frameworks.stats-V2-ndk",
        "android.hardware.power-V1-ndk",
        "android.hardware.thermal-V3-ndk",
        "pixel-power-ext-V1-ndk",
        "pixelatoms-cpp",
    ],
    static_libs: [
        "libpixelstats",
    ],
    export_shared_lib_headers: [
        "android.frameworks.stats-V2-ndk",
        "pixelatoms-cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wunused",
    ],
    tidy: true,
    tidy_checks: [
        "android-*",
        "cert-*",
        "clang-analyzer-security*",
    ],
    tidy_checks_as_errors: [
        "android-*",
        "clang-analyzer-security*",
        "cert-*",
    ],
}

sh_binary {
    name: "thermal_symlinks_pep",
    src: "thermal_symlinks_pep.sh",
    vendor: true,
    // Kills the stock symlinks script (direct PRODUCT_PACKAGES entry, so
    // transitive removal would be blocked -- needs an explicit override).
    // Pep script is a full mirror (links + link_ready=1), stock is redundant.
    // NOTE: the stock pixel-thermal-symlinks.rc (PRODUCT_COPY_FILES, not a
    // module) survives and will log one missing-binary error at boot;
    // harmless -- pep flow uses its own service. See device.mk.
    overrides: ["thermal_symlinks"],
}

vintf_fragment {
    name: "android.hardware.thermal-service.pixel.pep.xml",
    src: "android.hardware.thermal-service.pixel.pep.xml",
    vendor: true,
    // NOTE: intentionally NO overrides: here. The stock fragment is
    // suppressed via the pep cc_binary's overrides instead (see above):
    // a vintf_fragment's own overrides: never reaches
    // fsgen/removeOverriddenDeps (vintf deps are not in the filesystem
    // install set), so it is silently ignored on this tree -- and on some
    // trees it trips Soong's "found in multiple namespaces" error.
}

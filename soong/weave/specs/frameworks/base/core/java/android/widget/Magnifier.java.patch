+    /**
+     * PixelParts: re-reads Settings for real-time zoom/size/shape/offset updates.
+     * Geometry changes dismiss the current window so it is recreated on next show().
+     */
+    private void applyCustomMagnifierRuntime() {
+        long now = SystemClock.uptimeMillis();
+        if (now - mLastSettingsReadMs < MagnifierCustomizer.SETTINGS_READ_INTERVAL_MS) {
+            return;
+        }
+        mLastSettingsReadMs = now;
+        try {
+            MagnifierCustomizer.RuntimeDelta delta = MagnifierCustomizer.computeRuntime(
+                    mView.getContext(), mOriginalWindowWidth, mOriginalWindowHeight,
+                    mOriginalCornerRadius, mOriginalZoom, mWindowWidth, mWindowHeight,
+                    mWindowCornerRadius, mZoom, mIsFishEyeStyle, mCustomOffsetYApplied);
+            if (delta == null) {
+                return;
+            }
+            mZoom = delta.zoom;
+            mWindowWidth = delta.width;
+            mWindowHeight = delta.height;
+            mWindowCornerRadius = delta.cornerRadius;
+            mRuntimeOffsetYDeltaPx = delta.offsetDeltaPx;
+            if (delta.dismiss) {
+                mSourceWidth = mIsFishEyeStyle

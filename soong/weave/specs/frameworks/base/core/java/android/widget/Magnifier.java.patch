+    private int applyCustomMagnifierInitial(@NonNull Builder params) {
+        MagnifierCustomizer.InitialSpec spec;
+        try {
+            spec = MagnifierCustomizer.computeInitial(params.mView.getContext(),
+                    params.mWidth, params.mHeight, params.mCornerRadius, params.mZoom,
+                    params.mIsFishEyeStyle, params.mSourceWidth, params.mSourceHeight);
+        } catch (Exception e) {
+            Log.e(TAG, "[PixelParts] Magnifier applyCustomParams failed", e);
+            return 0;
+        }
+        if (spec == null) {
+            return 0;
+        }
+        params.mWidth = spec.width;
+        params.mHeight = spec.height;
+        params.mCornerRadius = spec.cornerRadius;
+        params.mZoom = spec.zoom;
+        params.mSourceWidth = spec.sourceWidth;
+        params.mSourceHeight = spec.sourceHeight;
+        params.mVerticalDefaultSourceToMagnifierOffset += spec.offsetDeltaPx;
+        return spec.offsetDeltaPx;
+    }

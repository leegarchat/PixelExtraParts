# Enforcing policy for the PEP release app.
# The app runs as stock system_app (sharedUserId android.uid.system);
# no custom domain, no permissive. Rules below serve the app itself
# plus other enforcing system processes (SystemUI/Settings) —
# e.g. battery sysfs reads and addon dex writes from whitelisted packages.

# Kill-switch reads: zygote evaluates it pre-fork, shell for
# on-device forensics.
get_prop(zygote, system_pixelparts_prop)
get_prop(shell, system_pixelparts_prop)

# --- legacy system_app rules (kept: SystemUI/Settings stay enforcing) ---
allow system_app system_pixelparts_prop:property_service set;
get_prop(system_app, system_pixelparts_prop)
allow system_app pixelparts_data_file:dir create_dir_perms;
allow system_app pixelparts_data_file:file create_file_perms;
# NOTE: no shell_data_file rules here on purpose — zygote writing a boot
# trace there trips core neverallows. Boot forensics = logcat immediately
# after boot (zygote lines), plus behavior test in a NON-injected app
# (custom loupe there == zygote hooks alive).
allow init pixelparts_data_file:dir r_dir_perms;
allow init pixelparts_data_file:file r_file_perms;
allow appdomain pixelparts_data_file:dir r_dir_perms;
allow appdomain pixelparts_data_file:file r_file_perms;
allow system_server pixelparts_data_file:dir r_dir_perms;
allow system_server pixelparts_data_file:file r_file_perms;
allow shell pixelparts_data_file:dir create_dir_perms;
allow shell pixelparts_data_file:file create_file_perms;
allow appdomain pixelparts_system_file:dir r_dir_perms;
allow appdomain pixelparts_system_file:file r_file_perms;
allow system_app sysfs_leds:dir r_dir_perms;
allow system_app sysfs_leds:file rw_file_perms;
allow system_app sysfs_leds:lnk_file read;
allow system_app sysfs_thermal:dir r_dir_perms;
allow system_app sysfs_thermal:file r_file_perms;
allow system_app sysfs_thermal:lnk_file read;
allow system_app sysfs_batteryinfo:dir r_dir_perms;
allow system_app sysfs_batteryinfo:file r_file_perms;
allow system_app sysfs_batteryinfo:lnk_file read;

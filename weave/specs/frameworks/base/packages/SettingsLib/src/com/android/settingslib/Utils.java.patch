+    private static float pixelPartsScalePercentToFloat(float scalePercent) {
+        final float clamped = Math.max(
+                PIXEL_PARTS_ICON_SHAPE_MIN_SCALE_PERCENT,
+                Math.min(PIXEL_PARTS_ICON_SHAPE_MAX_SCALE_PERCENT, scalePercent));
+        return clamped / 100f;
+    }

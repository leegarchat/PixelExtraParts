+            return new PixelPartsIconShapeConfig(
+                    PIXEL_PARTS_ICON_SHAPE_STRETCH,
+                    pixelPartsScalePercentToFloat(scalePercent),
+                    tintConfig);
+        }
+            return new PixelPartsIconShapeConfig(PIXEL_PARTS_ICON_SHAPE_DEFAULT, 1f, tintConfig);

+    private static final class PixelPartsScaledIconDrawable extends Drawable {
+        private final Drawable mDrawable;
+        private final float mScale;
+        private final ColorFilter mTintFilter;
+        private int mAlpha = 255;
+        private ColorFilter mColorFilter;
+
+        PixelPartsScaledIconDrawable(
+                @NonNull Drawable drawable, float scale, @Nullable Integer tintColor) {
+            mDrawable = drawable.mutate();
+            mScale = Math.max(0f, Math.min(2f, scale));
+            mTintFilter = tintColor != null
+                    ? new PorterDuffColorFilter(tintColor, PorterDuff.Mode.SRC_IN)
+                    : null;
+            if (mDrawable instanceof BitmapDrawable) {
+                final BitmapDrawable bitmapDrawable = (BitmapDrawable) mDrawable;
+                bitmapDrawable.setAntiAlias(true);
+                bitmapDrawable.setFilterBitmap(true);
+                bitmapDrawable.setDither(true);
+            }
+        }
+
+        @Override
+        public void draw(@NonNull Canvas canvas) {
+            if (mScale <= 0f) {
+                return;
+            }
+            final Rect bounds = getBounds();
+            final int save = canvas.saveLayerAlpha(
+                    bounds.left,
+                    bounds.top,
+                    bounds.right,
+                    bounds.bottom,
+                    mAlpha);
+            canvas.clipRect(bounds);
+            canvas.scale(mScale, mScale, bounds.exactCenterX(), bounds.exactCenterY());
+            mDrawable.setBounds(bounds);
+            final ColorFilter previousColorFilter = mDrawable.getColorFilter();
+            final ColorFilter activeColorFilter = mColorFilter != null ? mColorFilter : mTintFilter;
+            if (activeColorFilter != null) {
+                mDrawable.setColorFilter(activeColorFilter);
+            }
+            mDrawable.draw(canvas);
+            if (activeColorFilter != null) {
+                mDrawable.setColorFilter(previousColorFilter);
+            }
+            canvas.restoreToCount(save);
+        }
+
+        @Override
+        public void setAlpha(int alpha) {
+            mAlpha = Math.max(0, Math.min(255, alpha));
+            invalidateSelf();
+        }
+
+        @Override
+        public int getAlpha() {
+            return mAlpha;
+        }
+
+        @Override
+        public void setColorFilter(@Nullable ColorFilter colorFilter) {
+            mColorFilter = colorFilter;
+            mDrawable.setColorFilter(colorFilter);
+            invalidateSelf();
+        }
+
+        @Override
+        public int getOpacity() {
+            return PixelFormat.TRANSLUCENT;
+        }
+
+        @Override
+        public int getIntrinsicWidth() {
+            return mDrawable.getIntrinsicWidth();
+        }
+
+        @Override
+        public int getIntrinsicHeight() {
+            return mDrawable.getIntrinsicHeight();
+        }
+
+        @Override
+        public boolean isStateful() {

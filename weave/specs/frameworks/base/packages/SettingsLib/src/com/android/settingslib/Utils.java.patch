+    private static PixelPartsIconShapeOverride getPixelPartsIconShapeOverride(
+            @Nullable String packageName) {
+        if (packageName == null || packageName.isEmpty()) {
+            return null;
+        }
+        synchronized (PIXEL_PARTS_ICON_SHAPE_OVERRIDE_LOCK) {
+            refreshPixelPartsIconShapeOverridesLocked();
+            return sPixelPartsIconShapeOverrides.get(packageName);
+        }
+    }
+
+    private static void refreshPixelPartsIconShapeOverridesLocked() {
+        final long lastModified = PIXEL_PARTS_ICON_MAP_FILE.isFile()
+                ? PIXEL_PARTS_ICON_MAP_FILE.lastModified() : 0L;
+        if (sPixelPartsIconShapeOverridesLastModified == lastModified) {
+            return;
+        }
+        sPixelPartsIconShapeOverridesLastModified = lastModified;
+        sPixelPartsIconShapeOverrides.clear();
+        if (lastModified == 0L) {
+            return;
+        }
+        try (InputStream input = new FileInputStream(PIXEL_PARTS_ICON_MAP_FILE)) {
+            final JSONObject root = new JSONObject(
+                    new String(input.readAllBytes(), StandardCharsets.UTF_8));
+            final JSONObject overrides = root.optJSONObject("shapeOverrides");
+            if (overrides == null) {
+                return;
+            }
+            final Iterator<String> packages = overrides.keys();
+            while (packages.hasNext()) {
+                final String packageName = packages.next();
+                final PixelPartsIconShapeOverride override = readPixelPartsIconShapeOverride(
+                        overrides.optJSONObject(packageName), "system");
+                if (override != null && packageName != null && !packageName.isEmpty()) {
+                    sPixelPartsIconShapeOverrides.put(packageName, override);
+                }
+            }
+        } catch (IOException | JSONException e) {
+            sPixelPartsIconShapeOverrides.clear();
+        }
+    }
+
+    private static PixelPartsIconShapeOverride readPixelPartsIconShapeOverride(
+            @Nullable JSONObject appObject, @NonNull String areaName) {
+        if (appObject == null) {
+            return null;
+        }
+        final JSONObject area = appObject.optJSONObject(areaName);
+        if (area == null) {
+            return null;
+        }
+        final boolean removeShape = area.optBoolean("removeShape", false);
+        final boolean stretchShape = area.optBoolean("stretchShape", false) && !removeShape;
+        final int mode = removeShape
+                ? PIXEL_PARTS_ICON_SHAPE_REMOVE
+                : (stretchShape ? PIXEL_PARTS_ICON_SHAPE_STRETCH : PIXEL_PARTS_ICON_SHAPE_DEFAULT);
+        final float scalePercent = Math.max(
+                PIXEL_PARTS_ICON_SHAPE_MIN_SCALE_PERCENT,
+                Math.min(
+                        PIXEL_PARTS_ICON_SHAPE_MAX_SCALE_PERCENT,
+                (float) area.optDouble(
+                    "scalePercent",
+                    PIXEL_PARTS_ICON_SHAPE_DEFAULT_SCALE_PERCENT)));
+        return new PixelPartsIconShapeOverride(mode, scalePercent);
+    }

+    private static boolean hasPixelPartsIconOverride(
+            @NonNull Context context, @Nullable ApplicationInfo appInfo) {
+        return appInfo != null
+                && appInfo.packageName != null
+                && !appInfo.packageName.isEmpty()
+                && ApplicationPackageManager.hasPixelPartsIconOverride(
+                        context,
+                        appInfo.packageName,
+                        context.getResources().getConfiguration().densityDpi);

{
    "id": "flashnotify",
    "entryClass": "org.pixel.customparts.addon.flashnotify.FlashNotifyHook",
    "name": "Flash Notify",
    "author": "PixelExtraParts",
    "description": "Custom camera-flash blink on notifications: flash count and total blink time. Turn the system Settings > Accessibility > Flash notifications > Camera flash toggle OFF to avoid double blinking.",
    "version": "1.0.0",
    "targetPackages": [
        "com.android.systemui"
    ],
    "enabled": true,
    "accent": "#FFE082",
    "backgroundMode": "gradient",
    "backgroundAlpha": 55,
    "backgroundGradientSteps": [
        0,
        55,
        100
    ],
    "settings": [],
    "main": [
        {
            "id": "flash-notify",
            "title": "Flash Notify",
            "subtitle": "Flashlight blinks on notifications",
            "group": "system",
            "priority": 60,
            "settings": [
                {
                    "key": "flashnotify_info",
                    "type": "info",
                    "title": "How it works",
                    "description": "Hooks SystemUI notification delivery and blinks the torch itself with your count and total time. Disable the system Camera flash toggle, otherwise both will blink. Limits (measured on Pixel 8): one torch switch costs ~10ms of IPC, so a phase can't go below ~60ms — meaningful max is about total/120 (e.g. ~8 blinks per 1000ms). The total time always wins: blinking stops exactly at the budget even if the count isn't reached."
                },
                {
                    "key": "flashnotify_enabled",
                    "title": "Blink on notifications",
                    "description": "Master switch. Turning it on also disables the system Camera flash toggle. Takes effect immediately.",
                    "type": "switch",
                    "provider": "global",
                    "default": true,
                    "settingsOn": [
                        {
                            "provider": "system",
                            "key": "camera_flash_notification",
                            "type": "int",
                            "value": 0
                        }
                    ],
                    "category": "flashnotify_blink",
                    "categoryTitle": "Blink",
                    "categoryDescription": "Count and total blink time."
                },
                {
                    "key": "flashnotify_count",
                    "title": "Flash count",
                    "description": "How many times the torch blinks per notification.",
                    "type": "int",
                    "provider": "global",
                    "default": 2,
                    "min": 1,
                    "max": 50,
                    "step": 1,
                    "category": "flashnotify_blink"
                },
                {
                    "key": "flashnotify_strength",
                    "title": "Torch brightness",
                    "description": "Flashlight strength level, same scale as the system torch slider (max 45 on Pixel 8).",
                    "type": "int",
                    "provider": "global",
                    "default": 45,
                    "min": 1,
                    "max": 45,
                    "step": 1,
                    "category": "flashnotify_blink"
                },
                {
                    "key": "flashnotify_total_ms",
                    "title": "Total blink time",
                    "description": "Overall time the blinking lasts. Split evenly into on/off phases.",
                    "type": "int",
                    "provider": "global",
                    "default": 1200,
                    "min": 50,
                    "max": 10000,
                    "step": 100,
                    "unit": "ms",
                    "category": "flashnotify_blink"
                },
                {
                    "key": "flashnotify_test",
                    "title": "Test blink",
                    "description": "Fires one blink with current count and time, no notification needed.",
                    "type": "button",
                    "command": "am broadcast -a org.pixel.customparts.addon.flashnotify.TEST",
                    "showOutput": true
                },
                {
                    "key": "flashnotify_calls_enabled",
                    "title": "Blink on SIM calls",
                    "description": "Repeat bursts while a cellular call rings. SIM calls only — messenger calls have their own toggle below. If you use the Evolver flash-on-call, turn one of them off.",
                    "type": "switch",
                    "provider": "global",
                    "default": false,
                    "category": "flashnotify_calls",
                    "categoryTitle": "SIM calls",
                    "categoryDescription": "Burst: N blinks, pause, repeat until answered."
                },
                {
                    "key": "flashnotify_sim_blink_ms",
                    "title": "SIM burst window",
                    "description": "Total burst length in ms; flashes share it evenly, then pause. Window wins over count.",
                    "type": "int",
                    "provider": "global",
                    "default": 300,
                    "min": 50,
                    "max": 2000,
                    "step": 50,
                    "unit": "ms",
                    "category": "flashnotify_calls"
                },
                {
                    "key": "flashnotify_sim_count",
                    "title": "SIM burst count",
                    "description": "Blinks per burst.",
                    "type": "int",
                    "provider": "global",
                    "default": 3,
                    "min": 1,
                    "max": 50,
                    "step": 1,
                    "category": "flashnotify_calls"
                },
                {
                    "key": "flashnotify_sim_pause_ms",
                    "title": "SIM pause",
                    "description": "Silence between bursts.",
                    "type": "int",
                    "provider": "global",
                    "default": 1000,
                    "min": 0,
                    "max": 10000,
                    "step": 100,
                    "unit": "ms",
                    "category": "flashnotify_calls"
                },
                {
                    "key": "flashnotify_sim_brightness",
                    "title": "SIM flash brightness",
                    "description": "Torch strength for SIM bursts.",
                    "type": "int",
                    "provider": "global",
                    "default": 45,
                    "min": 1,
                    "max": 45,
                    "step": 1,
                    "category": "flashnotify_calls"
                },
                {
                    "key": "flashnotify_sim_tests_header",
                    "title": "SIM tests",
                    "description": "Simulated SIM-pattern bursts. A real call preempts the test.",
                    "type": "info"
                },
                {
                    "key": "flashnotify_test_call_2s",
                    "title": "Test SIM call 2s",
                    "description": "Simulate a SIM-pattern call burst for 2 seconds, no real call needed.",
                    "type": "button",
                    "command": "am broadcast -a org.pixel.customparts.addon.flashnotify.TEST_CALL --ei seconds 2",
                    "showOutput": true
                },
                {
                    "key": "flashnotify_test_call_5s",
                    "title": "Test SIM call 5s",
                    "description": "Simulate a SIM-pattern call burst for 5 seconds, no real call needed.",
                    "type": "button",
                    "command": "am broadcast -a org.pixel.customparts.addon.flashnotify.TEST_CALL --ei seconds 5",
                    "showOutput": true
                },
                {
                    "key": "flashnotify_test_call_10s",
                    "title": "Test SIM call 10s",
                    "description": "Simulate a SIM-pattern call burst for 10 seconds, no real call needed.",
                    "type": "button",
                    "command": "am broadcast -a org.pixel.customparts.addon.flashnotify.TEST_CALL --ei seconds 10",
                    "showOutput": true
                },
                {
                    "key": "flashnotify_voip_enabled",
                    "title": "Blink on messenger calls",
                    "description": "Repeat bursts while a messenger (VoIP) call is active — tracked by its call-style notification. Stops when the call notification goes away.",
                    "type": "switch",
                    "provider": "global",
                    "default": false,
                    "category": "flashnotify_voip",
                    "categoryTitle": "Messenger calls",
                    "categoryDescription": "Burst: N blinks, pause, repeat until hangup."
                },
                {
                    "key": "flashnotify_voip_blink_ms",
                    "title": "VoIP burst window",
                    "description": "Total burst length in ms; flashes share it evenly, then pause. Window wins over count.",
                    "type": "int",
                    "provider": "global",
                    "default": 300,
                    "min": 50,
                    "max": 2000,
                    "step": 50,
                    "unit": "ms",
                    "category": "flashnotify_voip"
                },
                {
                    "key": "flashnotify_voip_count",
                    "title": "VoIP burst count",
                    "description": "Blinks per burst.",
                    "type": "int",
                    "provider": "global",
                    "default": 3,
                    "min": 1,
                    "max": 50,
                    "step": 1,
                    "category": "flashnotify_voip"
                },
                {
                    "key": "flashnotify_voip_pause_ms",
                    "title": "VoIP pause",
                    "description": "Silence between bursts.",
                    "type": "int",
                    "provider": "global",
                    "default": 1000,
                    "min": 0,
                    "max": 10000,
                    "step": 100,
                    "unit": "ms",
                    "category": "flashnotify_voip"
                },
                {
                    "key": "flashnotify_voip_brightness",
                    "title": "VoIP flash brightness",
                    "description": "Torch strength for messenger bursts.",
                    "type": "int",
                    "provider": "global",
                    "default": 45,
                    "min": 1,
                    "max": 45,
                    "step": 1,
                    "category": "flashnotify_voip"
                },
                {
                    "key": "flashnotify_voip_tests_header",
                    "title": "VoIP tests",
                    "description": "Simulated VoIP-pattern bursts. A real call preempts the test.",
                    "type": "info"
                },
                {
                    "key": "flashnotify_test_voip_2s",
                    "title": "Test VoIP call 2s",
                    "description": "Simulate a VoIP-pattern call burst for 2 seconds, no real call needed.",
                    "type": "button",
                    "command": "am broadcast -a org.pixel.customparts.addon.flashnotify.TEST_VOIP --ei seconds 2",
                    "showOutput": true
                },
                {
                    "key": "flashnotify_test_voip_5s",
                    "title": "Test VoIP call 5s",
                    "description": "Simulate a VoIP-pattern call burst for 5 seconds, no real call needed.",
                    "type": "button",
                    "command": "am broadcast -a org.pixel.customparts.addon.flashnotify.TEST_VOIP --ei seconds 5",
                    "showOutput": true
                },
                {
                    "key": "flashnotify_test_voip_10s",

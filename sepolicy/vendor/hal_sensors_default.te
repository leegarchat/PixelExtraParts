# The PixelParts backlight labels are also read by USF DisplayInfoService.
allow hal_sensors_default sysfs_pixelparts_leds:dir r_dir_perms;
allow hal_sensors_default sysfs_pixelparts_leds:file r_file_perms;
allow hal_sensors_default sysfs_pixelparts_leds:lnk_file read;

allow hal_sensors_default sysfs_write_leds:dir r_dir_perms;
allow hal_sensors_default sysfs_write_leds:file r_file_perms;
allow hal_sensors_default sysfs_write_leds:lnk_file read;

allow hal_sensors_default sysfs_leds:dir r_dir_perms;
allow hal_sensors_default sysfs_leds:file r_file_perms;
allow hal_sensors_default sysfs_leds:lnk_file read;
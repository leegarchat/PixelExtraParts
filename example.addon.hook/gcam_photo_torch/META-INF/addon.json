{
    "id": "gcam_photo_torch",
    "entryClass": "org.pixel.customparts.addon.gcam.GcamPhotoTorchHook",
    "name": "GCam Photo Torch",
    "author": "LeeGarChat",
    "description": "Adds an always-on torch option to Google Camera photo flash controls.",
    "version": "1.1",
    "targetPackages": [
        "com.google.android.GoogleCamera"
    ],
    "enabled": true,
    "accent": "#FFD18B",
    "backgroundMode": "gradient",
    "backgroundAlpha": 60,
    "backgroundGradientSteps": [
        0,
        55,
        100
    ],
    "settings": [],
    "main": [
        {
            "id": "gcam-photo-torch",
            "title": "GCam Photo Torch",
            "subtitle": "Persistent Torch in the Google Camera flash menu.",
            "icon": "PhotoCamera",
            "iconType": "app",
            "iconShape": "circle",
            "iconColor": "#FFD18B",
            "iconBackground": "#3E3424",
            "group": "camera",
            "priority": 70,
            "settings": [
                {
                    "key": "gcam_photo_torch_main_group",
                    "type": "group",
                    "title": "Photo flash",
                    "description": "Controls the added Torch item.",
                    "mode": "inline",
                    "icon": "FlashOn",
                    "iconType": "app",
                    "iconShape": "circle",
                    "iconSize": 20,
                    "settings": [
                        {
                            "key": "gcam_photo_torch_enabled",
                            "title": "Enable Torch",
                            "description": "Adds a persistent torch mode to the flash menu.",
                            "type": "switch",
                            "provider": "global",
                            "default": true
                        }
                    ]
                }
            ]
        }
    ],

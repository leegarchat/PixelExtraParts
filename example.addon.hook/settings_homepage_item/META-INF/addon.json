{
    "id": "settings_homepage_item",
    "entryClass": "org.pixel.customparts.addon.settings.SettingsHomepageItemHook",
    "name": "Settings Homepage Item",
    "author": "LeeGarChat",
    "description": "Injects Pixel Extra Parts into a separate top-level Settings homepage area without modifying the Settings package.",
    "version": "1.1",
    "targetPackages": [
        "com.android.settings"
    ],
    "enabled": true,
    "accent": "#7EE3B4",
    "backgroundMode": "gradient",
    "backgroundAlpha": 55,
    "backgroundGradientSteps": [
        0,
        60,
        100
    ],
    "settings": [],
    "main": [
        {
            "id": "settings-homepage-item",
            "title": "Settings Homepage Item",
            "subtitle": "Pixel Extra Parts item on the Settings homepage.",
            "icon": "Settings",
            "iconType": "app",
            "iconShape": "circle",
            "iconColor": "#7EE3B4",
            "iconBackground": "#203A31",
            "group": "system",
            "priority": 80,
            "settings": [
                {
                    "key": "settings_homepage_item_enabled",
                    "title": "Show Pixel Extra Parts",
                    "description": "Adds an item to the Settings homepage.",
                    "type": "switch",
                    "provider": "global",
                    "default": true,
                    "accent": "#7EE3B4"
                },
                {
                    "key": "settings_homepage_item_category_order",
                    "title": "Settings position",
                    "description": "Lower value places it higher in the list.",
                    "type": "int",
                    "provider": "global",
                    "default": -139,
                    "min": -300,
                    "max": 300,
                    "step": 1
                },
                {
                    "key": "settings_homepage_item_colored_icon",
                    "title": "Colored icon",
                    "description": "Uses the Pixel Extra Parts launcher icon.",
                    "type": "switch",
                    "provider": "global",
                    "default": false
                },
                {
                    "key": "settings_homepage_item_background_color_mode",
                    "title": "Icon background",
                    "description": "Auto uses the Settings color. Custom uses the field below.",
                    "type": "select",
                    "provider": "global",
                    "default": "auto",
                    "options": [
                        {
                            "value": "auto",
                            "label": "Auto"
                        },
                        {
                            "value": "custom",
                            "label": "Custom hex"
                        },
                        {
                            "value": "#67DDF7",
                            "label": "Blue"
                        },
                        {
                            "value": "#7EE3B4",
                            "label": "Green"
                        },
                        {
                            "value": "#D7B8FF",
                            "label": "Purple"
                        },
                        {
                            "value": "#FFB4CA",
                            "label": "Rose"
                        },
                        {
                            "value": "#FFD18B",
                            "label": "Amber"
                        }
                    ]
                },
                {
                    "key": "settings_homepage_item_background_custom_hex",
                    "title": "Custom background",
                    "description": "Used in Custom hex mode.",
                    "type": "color",
                    "provider": "global",
                    "default": "#67DDF7",
                    "format": "hex"
                },
                {
                    "key": "settings_homepage_item_icon_color_mode",
                    "title": "Glyph color",
                    "description": "Auto uses the Settings color. Custom uses the field below.",
                    "type": "select",
                    "provider": "global",
                    "default": "auto",
                    "options": [
                        {
                            "value": "auto",
                            "label": "Auto"
                        },
                        {
                            "value": "custom",
                            "label": "Custom hex"
                        },
                        {
                            "value": "#0B3D4F",
                            "label": "Blue"
                        },
                        {
                            "value": "#0B4B37",
                            "label": "Green"
                        },
                        {
                            "value": "#47216A",
                            "label": "Purple"
                        },
                        {
                            "value": "#6B1238",
                            "label": "Rose"
                        },
                        {
                            "value": "#5C3900",
                            "label": "Amber"
                        }
                    ]
                },
                {
                    "key": "settings_homepage_item_icon_custom_hex",
                    "title": "Custom glyph",
                    "description": "Used in Custom hex mode.",
                    "type": "color",
                    "provider": "global",
                    "default": "#0B3D4F",
                    "format": "hex"
                }
            ]
        }
    ],

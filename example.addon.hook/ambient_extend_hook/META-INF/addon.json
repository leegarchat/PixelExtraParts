{
    "id": "ambient_extend_hook",
    "entryClass": "org.pixel.customparts.addon.ambient.AmbientExtendHook",
    "name": "Ambient Extend",
    "author": "LeeGarChat",
    "description": "AOD timeout, ambient Smart Pixels, and extra Doze dimming for SystemUI.",
    "version": "1.4.0",
    "targetPackages": [
        "com.android.systemui"
    ],
    "enabled": true,
    "updateUrl": "https://github.com/leegarchat/PixelExtraParts/raw/refs/heads/testing/OTA/addons/ambient.json",
    "accent": "#64D8FF",
    "backgroundMode": "gradient",
    "backgroundAlpha": 70,
    "backgroundGradientSteps": [
        0,
        45,
        100
    ],
    "backgroundScope": "full",
    "settings": [],
    "main": [
        {
            "id": "ambient-extend",
            "title": "Ambient Extend",
            "subtitle": "AOD timeout, Smart Pixels and extra dimming.",
            "icon": "BrightnessHigh",
            "iconType": "app",
            "iconShape": "circle",
            "iconColor": "#8BDDED",
            "iconBackground": "#263A40",
            "group": "systemui",
            "priority": 85,
            "settings": [
                {
                    "key": "demo_divider_solid",
                    "type": "divider",
                    "thickness": 6
                },
                {
                    "key": "ambient_timeout_group",
                    "title": "AOD blackout",
                    "description": "Turns off AOD after the configured delay.",
                    "type": "group",
                    "mode": "inline",
                    "icon": "BrightnessHigh",
                    "iconType": "app",
                    "iconShape": "circle",
                    "iconSize": 20,
                    "settings": [
                        {
                            "key": "demo_divider_dashed",
                            "type": "dashed_line",
                            "thickness": 1
                        },
                        {
                            "key": "ambient_extend_hook_timeout_enabled",
                            "title": "Enable blackout",
                            "description": "Dims AOD after the selected delay.",
                            "type": "toggle",
                            "provider": "global",
                            "default": false
                        },
                        {
                            "key": "ambient_extend_hook_timeout_seconds",
                            "title": "Delay",
                            "type": "int",
                            "provider": "global",
                            "default": 60,
                            "min": 1,
                            "max": 600,
                            "step": 1,
                            "unit": "s"
                        },
                        {
                            "key": "ambient_extend_hook_timeout_fade_ms",
                            "title": "Fade duration",
                            "type": "int",
                            "provider": "global",
                            "default": 1200,
                            "min": 0,
                            "max": 10000,
                            "step": 50,
                            "unit": "ms"
                        }
                    ]
                },
                {
                    "key": "ambient_smart_pixels_group",
                    "title": "Smart Pixels",
                    "description": "Reduces the number of active pixels in doze.",
                    "type": "group",
                    "mode": "inline",
                    "icon": "Apps",
                    "iconType": "app",
                    "iconShape": "circle",
                    "iconSize": 20,
                    "settings": [
                        {
                            "key": "ambient_extend_hook_smart_pixels_aod_enabled",
                            "title": "Enable Smart Pixels",
                            "type": "toggle",
                            "provider": "global",
                            "default": false
                        },
                        {
                            "key": "ambient_extend_hook_smart_pixels_aod_percent",
                            "title": "Disabled pixels",
                            "type": "int",
                            "provider": "global",
                            "default": 25,
                            "min": 10,
                            "max": 100,
                            "step": 1,
                            "unit": "%"
                        },
                        {
                            "key": "ambient_extend_hook_smart_pixels_shift_enabled",
                            "title": "Mask shifting",
                            "description": "Periodically shifts the pixel mask.",
                            "type": "toggle",
                            "provider": "global",
                            "default": false
                        }
                    ]
                },
                {
                    "key": "ambient_dimming_group",
                    "title": "Doze dimming",
                    "description": "Extra dimming layer over ambient.",
                    "type": "group",
                    "mode": "inline",
                    "icon": "Tune",
                    "iconType": "app",
                    "iconShape": "circle",
                    "iconSize": 20,
                    "settings": [
                        {
                            "key": "ambient_extend_hook_dim_enabled",
                            "title": "Enable dimming",
                            "type": "toggle",
                            "provider": "global",
                            "default": false
                        },
                        {
                            "key": "ambient_extend_hook_dim_percent",
                            "title": "Dimming strength",
                            "type": "int",
                            "provider": "global",
                            "default": 30,
                            "min": 0,
                            "max": 100,
                            "step": 1,
                            "unit": "%"
                        }
                    ]
                }
            ]
        }
    ],

{
    "id": "ambient_extend_hook",
    "entryClass": "org.pixel.customparts.addon.ambient.AmbientExtendHook",
    "name": "Ambient Extend",
    "author": "LeeGarChat",
    "description": "AOD timeout, ambient Smart Pixels, and extra Doze dimming for SystemUI.",
    "version": "2.0.0",
    "targetPackages": [
        "com.android.systemui"
    ],
    "enabled": true,
    "updateUrl": "https://raw.githubusercontent.com/leegarchat/PixelExtraParts/heads/testing/OTA/addons/ambient_extend_hook.json",
    "accent": "#64D8FF",
    "backgroundMode": "gradient",
    "backgroundAlpha": 70,
    "backgroundGradientSteps": [
        0,
        45,
        100
    ],
    "backgroundScope": "full",
    "settings": [],
    "main": [
        {
            "id": "ambient-extend",
            "title": "Ambient Extend",
            "subtitle": "AOD blackout, pixel mask, and low-light doze dimming.",
            "icon": "Rounded.DarkMode",
            "iconType": "app",
            "iconShape": "circle",
            "iconColor": "#8BDDED",
            "iconBackground": "#263A40",
            "group": "systemui",
            "priority": 85,
            "settings": [
                {
                    "key": "ambient_extend_hook_timeout_enabled",
                    "title": "Enable blackout",
                    "description": "Hide the AOD surface after the delay instead of leaving it fully lit.",
                    "type": "toggle",
                    "provider": "global",
                    "default": false,
                    "category": "aod_blackout",
                    "categoryTitle": "AOD blackout",
                    "categoryDescription": "Turn the always-on display off after a quiet delay."
                },
                {
                    "key": "ambient_extend_hook_timeout_seconds",
                    "title": "Delay",
                    "description": "Seconds to keep AOD visible before blackout starts.",
                    "type": "int",
                    "provider": "global",
                    "default": 60,
                    "min": 1,
                    "max": 600,
                    "step": 1,
                    "unit": "s",
                    "category": "aod_blackout"
                },
                {
                    "key": "ambient_extend_hook_timeout_fade_ms",
                    "title": "Fade duration",
                    "description": "Length of the transition into blackout.",
                    "type": "int",
                    "provider": "global",
                    "default": 1200,
                    "min": 0,
                    "max": 10000,
                    "step": 50,
                    "unit": "ms",
                    "category": "aod_blackout"
                },
                {
                    "key": "ambient_extend_hook_smart_pixels_aod_enabled",
                    "title": "Enable Smart Pixels",
                    "description": "Apply the pixel mask while the device is in doze.",
                    "type": "toggle",
                    "provider": "global",
                    "default": false,
                    "category": "smart_pixels",
                    "categoryTitle": "Smart Pixels",
                    "categoryDescription": "Reduce active pixels while keeping the ambient layout readable."
                },
                {
                    "key": "ambient_extend_hook_smart_pixels_aod_percent",
                    "title": "Disabled pixels",
                    "description": "Share of pixels masked out on the ambient surface.",
                    "type": "int",
                    "provider": "global",
                    "default": 25,
                    "min": 10,
                    "max": 100,
                    "step": 1,
                    "unit": "%",
                    "category": "smart_pixels"
                },
                {
                    "key": "ambient_extend_hook_smart_pixels_shift_enabled",
                    "title": "Mask shifting",
                    "description": "Move the mask pattern over time to avoid static hot spots.",
                    "type": "toggle",
                    "provider": "global",
                    "default": false,
                    "category": "smart_pixels"
                },
                {
                    "key": "ambient_extend_hook_dim_enabled",
                    "title": "Enable dimming",
                    "description": "Apply the additional dim layer while dozing.",
                    "type": "toggle",
                    "provider": "global",
                    "default": false,
                    "category": "doze_dimming",
                    "categoryTitle": "Doze dimming",
                    "categoryDescription": "Add a soft darkness layer over ambient content."
                },
                {
                    "key": "ambient_extend_hook_dim_percent",
                    "title": "Dimming strength",
                    "description": "Opacity of the extra dim layer.",
                    "type": "int",
                    "provider": "global",
                    "default": 30,
                    "min": 0,
                    "max": 100,
                    "step": 1,
                    "unit": "%",
                    "category": "doze_dimming"
                }
            ]
        }
    ],

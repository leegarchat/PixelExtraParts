{
    "id": "icon_manager_settings",
    "name": "Icon Manager Settings UI",
    "author": "PixelExtraParts",
    "description": "Settings-only addon UI for Icon Manager advanced controls.",
    "version": "1.0.1",
    "enabled": true,
    "backgroundMode": "gradient",
    "backgroundAlpha": 72,
    "backgroundGradientSteps": [
        0,
        36,
        78,
        100
    ],
    "backgroundBlur": true,
    "backgroundBlurRadius": 14,
    "backgroundScope": "header",
    "settings": [],
    "main": [
        {
            "id": "main/icon-manager/advanced-settings",
            "title": "Advanced icon settings",
            "subtitle": "System, notifications, Pixel Launcher, tinting and All Apps",
            "icon": "Apps",
            "iconType": "app",
            "iconShape": "circle",
            "iconColor": "#D7B8FF",
            "iconBackground": "#332A45",
            "targetActivity": "AppIconsActivity",
            "targetSlot": "advanced",
            "priority": 1000,
            "settings": [
                {
                    "key": "icon_manager_core_divider",
                    "type": "dashed_line",
                    "thickness": 1
                },
                {
                    "key": "icon_manager_core_group",
                    "type": "group",
                    "title": "Core toggles",
                    "description": "Global Icon Manager enable state and Pixel Launcher integration.",
                    "mode": "inline",
                    "defaultExpanded": false,
                    "icon": "Rounded.Apps",
                    "iconType": "app",
                    "iconShape": "rounded",
                    "iconSize": 20,
                    "settings": [
                        {
                            "key": "pixelparts_app_icons_enabled",
                            "title": "Enable icon system",
                            "type": "switch",
                            "provider": "global",
                            "default": true
                        },
                        {
                            "key": "pixelparts_app_icons_launcher_enabled",
                            "title": "Apply in Pixel Launcher",
                            "type": "switch",
                            "provider": "global",
                            "default": true
                        }
                    ]
                },
                {
                    "key": "icon_manager_shape_divider",
                    "type": "dashed_line",
                    "thickness": 1
                },
                {
                    "key": "icon_manager_shape_group",
                    "type": "group",
                    "title": "Shape and scale",
                    "description": "Adaptive icon shape overrides for system, notification and launcher surfaces.",
                    "mode": "inline",
                    "defaultExpanded": false,
                    "icon": "Rounded.Category",
                    "iconType": "app",
                    "iconShape": "rounded",
                    "iconSize": 20,
                    "settings": [
                        {
                            "key": "pixelparts_app_icons_system_stretch_shape",
                            "title": "Stretch system icon shape",
                            "type": "switch",
                            "provider": "global",
                            "default": false,
                            "exclusiveWith": [
                                "pixelparts_app_icons_system_remove_shape"
                            ],
                            "enabledIfAll": [
                                "pixelparts_app_icons_enabled"
                            ]
                        },
                        {
                            "key": "pixelparts_app_icons_system_remove_shape",
                            "title": "Remove system adaptive icon background",
                            "type": "switch",
                            "provider": "global",
                            "default": false,
                            "exclusiveWith": [
                                "pixelparts_app_icons_system_stretch_shape"
                            ],
                            "enabledIfAll": [
                                "pixelparts_app_icons_enabled"
                            ]
                        },
                        {
                            "key": "pixelparts_app_icons_system_shape_scale",
                            "title": "System shape scale",
                            "type": "float",
                            "provider": "global",
                            "default": 72,
                            "min": 0,
                            "max": 200,
                            "step": 1,
                            "unit": "%",
                            "enabledIfAny": [
                                "pixelparts_app_icons_system_stretch_shape",
                                "pixelparts_app_icons_system_remove_shape"
                            ]
                        },
                        {
                            "key": "pixelparts_app_icons_notification_stretch_shape",
                            "title": "Stretch notification shape",
                            "type": "switch",
                            "provider": "global",
                            "default": false,
                            "exclusiveWith": [
                                "pixelparts_app_icons_notification_remove_shape"
                            ],
                            "enabledIfAll": [
                                "pixelparts_app_icons_enabled"
                            ]
                        },
                        {
                            "key": "pixelparts_app_icons_notification_remove_shape",
                            "title": "Remove notification icon background",
                            "type": "switch",
                            "provider": "global",
                            "default": false,
                            "exclusiveWith": [
                                "pixelparts_app_icons_notification_stretch_shape"
                            ],
                            "enabledIfAll": [
                                "pixelparts_app_icons_enabled"
                            ]
                        },
                        {
                            "key": "pixelparts_app_icons_notification_shape_scale",
                            "title": "Notification shape scale",
                            "type": "float",
                            "provider": "global",
                            "default": 72,
                            "min": 0,
                            "max": 200,
                            "step": 1,
                            "unit": "%",
                            "enabledIfAny": [
                                "pixelparts_app_icons_notification_stretch_shape",
                                "pixelparts_app_icons_notification_remove_shape"
                            ]
                        },
                        {
                            "key": "pixelparts_app_icons_launcher_stretch_shape",
                            "title": "Stretch Pixel Launcher shape",
                            "type": "switch",
                            "provider": "global",
                            "default": false,
                            "exclusiveWith": [
                                "pixelparts_app_icons_launcher_remove_shape"
                            ],
                            "enabledIfAll": [
                                "pixelparts_app_icons_launcher_enabled"
                            ]
                        },
                        {
                            "key": "pixelparts_app_icons_launcher_remove_shape",
                            "title": "Remove Pixel Launcher icon background",
                            "type": "switch",
                            "provider": "global",
                            "default": false,
                            "exclusiveWith": [
                                "pixelparts_app_icons_launcher_stretch_shape"
                            ],
                            "enabledIfAll": [
                                "pixelparts_app_icons_launcher_enabled"
                            ]
                        },
                        {
                            "key": "pixelparts_app_icons_launcher_shape_scale",
                            "title": "Pixel Launcher shape scale",
                            "type": "float",
                            "provider": "global",
                            "default": 72,
                            "min": 0,
                            "max": 200,
                            "step": 1,
                            "unit": "%",
                            "enabledIfAny": [
                                "pixelparts_app_icons_launcher_stretch_shape",
                                "pixelparts_app_icons_launcher_remove_shape"
                            ]
                        }
                    ]
                },
                {
                    "key": "icon_manager_tint_divider",
                    "type": "dashed_line",
                    "thickness": 1
                },
                {
                    "key": "icon_manager_tint_group",
                    "type": "group",
                    "title": "Tinting",
                    "description": "Background and foreground color for generated icons.",
                    "mode": "inline",
                    "defaultExpanded": false,
                    "icon": "Rounded.Palette",
                    "iconType": "app",
                    "iconShape": "rounded",
                    "iconSize": 20,
                    "settings": [
                        {
                            "key": "pixelparts_app_icons_shape_background_tint_mode",
                            "title": "Background tinting",
                            "type": "select",
                            "provider": "global",
                            "default": "0",
                            "options": [
                                {
                                    "value": "0",
                                    "label": "Off"
                                },
                                {
                                    "value": "1",
                                    "label": "Color"
                                },
                                {
                                    "value": "2",
                                    "label": "Auto"
                                }
                            ]
                        },
                        {
                            "key": "pixelparts_app_icons_shape_background_tint_color",
                            "title": "Background color",
                            "type": "color",
                            "provider": "global",
                            "default": "#00000000",
                            "format": "hex_argb",
                            "alpha": true,
                            "enabledIfAll": [
                                "pixelparts_app_icons_shape_background_tint_mode=1"
                            ]
                        },
                        {
                            "key": "pixelparts_app_icons_shape_foreground_tint_mode",
                            "title": "Icon tinting",
                            "type": "select",
                            "provider": "global",
                            "default": "0",
                            "options": [
                                {
                                    "value": "0",
                                    "label": "Off"
                                },
                                {
                                    "value": "1",
                                    "label": "Color"
                                },
                                {
                                    "value": "2",
                                    "label": "Auto"
                                }
                            ]
                        },
                        {
                            "key": "pixelparts_app_icons_shape_foreground_tint_color",
                            "title": "Icon color",
                            "type": "color",
                            "provider": "global",
                            "default": "#FFFFFFFF",
                            "format": "hex_argb",
                            "alpha": true,
                            "enabledIfAll": [
                                "pixelparts_app_icons_shape_foreground_tint_mode=1"
                            ]
                        }
                    ]
                },
                {
                    "key": "icon_manager_all_apps_divider",
                    "type": "dashed_line",
                    "thickness": 1
                },
                {
                    "key": "icon_manager_all_apps_group",
                    "type": "group",
                    "title": "All Apps and per-app shapes",
                    "description": "Workspace, All Apps, suggested icons and per-app shape overrides.",
                    "mode": "inline",
                    "defaultExpanded": false,
                    "icon": "Rounded.GridView",
                    "iconType": "app",
                    "iconShape": "rounded",
                    "iconSize": 20,
                    "settings": [
                        {
                            "key": "pixelparts_icon_shape_workspace_match_all_apps",
                            "title": "Workspace shape matches All Apps",
                            "type": "switch",
                            "provider": "global",
                            "default": false
                        },
                        {
                            "key": "pixelparts_icon_shape_ignore_custom_settings",
                            "title": "Ignore per-app shapes",
                            "type": "switch",
                            "provider": "global",
                            "default": false
                        },
                        {
                            "key": "pixelparts_icon_shape_all_apps_follow_workspace",
                            "title": "All Apps follows the workspace",
                            "type": "switch",
                            "provider": "global",
                            "default": false
                        },
                        {
                            "key": "pixelparts_icon_shape_all_apps_themed_icons",
                            "title": "Themed icons in All Apps",
                            "type": "switch",
                            "provider": "global",
                            "default": false
                        },
                        {
                            "key": "pixelparts_icon_shape_all_apps_suggestions_themed_icons",
                            "title": "Themed icons in suggestions",
                            "type": "switch",
                            "provider": "global",
                            "default": false
                        }
                    ]
                }
            ]
        }
    ],

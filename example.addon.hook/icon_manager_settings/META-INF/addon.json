{
    "id": "icon_manager_settings",
    "name": "Icon Manager Settings UI",
    "author": "LeeGarChat",
    "description": "Settings-only addon UI for Icon Manager advanced controls.",
    "version": "2.0.0",
    "enabled": true,
    "updateUrl": "https://raw.githubusercontent.com/leegarchat/PixelExtraParts/heads/testing/OTA/addons/icon_manager_settings.json",
    "backgroundMode": "gradient",
    "backgroundAlpha": 48,
    "backgroundGradientSteps": [
        0,
        45,
        100
    ],
    "backgroundScope": "header",
    "settings": [],
    "main": [
        {
            "id": "main/icon-manager/advanced-settings",
            "title": "Advanced icon settings",
            "subtitle": "Shape, tint, launcher, and All Apps controls",
            "icon": "Rounded.Apps",
            "iconType": "app",
            "iconShape": "circle",
            "iconColor": "#D7B8FF",
            "iconBackground": "#332A45",
            "targetActivity": "AppIconsActivity",
            "targetSlot": "advanced",
            "priority": 1000,
            "settings": [
                {
                    "key": "pixelparts_app_icons_enabled",
                    "title": "Enable icon system",
                    "description": "Master switch for system icon shape and tint overrides.",
                    "type": "switch",
                    "provider": "global",
                    "default": true,
                    "category": "icon_manager_core_group",
                    "categoryTitle": "Core toggles",
                    "categoryDescription": "Global Icon Manager enable state and Pixel Launcher integration."
                },
                {
                    "key": "pixelparts_app_icons_launcher_enabled",
                    "title": "Apply in Pixel Launcher",
                    "description": "Allow launcher-specific shape and All Apps rules to use these settings.",
                    "type": "switch",
                    "provider": "global",
                    "default": true,
                    "category": "icon_manager_core_group"
                },
                {
                    "key": "pixelparts_app_icons_system_stretch_shape",
                    "title": "Stretch system icon shape",
                    "description": "Scale the adaptive mask on system surfaces instead of preserving the original padding.",
                    "type": "switch",
                    "provider": "global",
                    "default": false,
                    "exclusiveWith": [
                        "pixelparts_app_icons_system_remove_shape"
                    ],
                    "enabledIfAll": [
                        "pixelparts_app_icons_enabled"
                    ],
                    "category": "icon_manager_shape_group",
                    "categoryTitle": "Shape and scale",
                    "categoryDescription": "Adaptive icon shape overrides for system, notification and launcher surfaces."
                },
                {
                    "key": "pixelparts_app_icons_system_remove_shape",
                    "title": "Remove system adaptive icon background",
                    "description": "Draw system icons without the generated adaptive icon backing shape.",
                    "type": "switch",
                    "provider": "global",
                    "default": false,
                    "exclusiveWith": [
                        "pixelparts_app_icons_system_stretch_shape"
                    ],
                    "enabledIfAll": [
                        "pixelparts_app_icons_enabled"
                    ],
                    "category": "icon_manager_shape_group"
                },
                {
                    "key": "pixelparts_app_icons_system_shape_scale",
                    "title": "System shape scale",
                    "description": "Fine tune the mask size used by system icon surfaces.",
                    "type": "float",
                    "provider": "global",
                    "default": 72,
                    "min": 0,
                    "max": 200,
                    "step": 1,
                    "unit": "%",
                    "enabledIfAny": [
                        "pixelparts_app_icons_system_stretch_shape",
                        "pixelparts_app_icons_system_remove_shape"
                    ],
                    "category": "icon_manager_shape_group"
                },
                {
                    "key": "pixelparts_app_icons_notification_stretch_shape",
                    "title": "Stretch notification shape",
                    "description": "Scale notification icon masks to better fill their available slot.",
                    "type": "switch",
                    "provider": "global",
                    "default": false,
                    "exclusiveWith": [
                        "pixelparts_app_icons_notification_remove_shape"
                    ],
                    "enabledIfAll": [
                        "pixelparts_app_icons_enabled"
                    ],
                    "category": "icon_manager_shape_group"
                },
                {
                    "key": "pixelparts_app_icons_notification_remove_shape",
                    "title": "Remove notification icon background",
                    "description": "Hide the adaptive backing shape for notification icons.",
                    "type": "switch",
                    "provider": "global",
                    "default": false,
                    "exclusiveWith": [
                        "pixelparts_app_icons_notification_stretch_shape"
                    ],
                    "enabledIfAll": [
                        "pixelparts_app_icons_enabled"
                    ],
                    "category": "icon_manager_shape_group"
                },
                {
                    "key": "pixelparts_app_icons_notification_shape_scale",
                    "title": "Notification shape scale",
                    "description": "Adjust notification icon mask size after stretch or remove mode is enabled.",
                    "type": "float",
                    "provider": "global",
                    "default": 72,
                    "min": 0,
                    "max": 200,
                    "step": 1,
                    "unit": "%",
                    "enabledIfAny": [
                        "pixelparts_app_icons_notification_stretch_shape",
                        "pixelparts_app_icons_notification_remove_shape"
                    ],
                    "category": "icon_manager_shape_group"
                },
                {
                    "key": "pixelparts_app_icons_launcher_stretch_shape",
                    "title": "Stretch Pixel Launcher shape",
                    "description": "Scale launcher icon masks so themed and adaptive icons fill the launcher slot.",
                    "type": "switch",
                    "provider": "global",
                    "default": false,
                    "exclusiveWith": [
                        "pixelparts_app_icons_launcher_remove_shape"
                    ],
                    "enabledIfAll": [
                        "pixelparts_app_icons_launcher_enabled"
                    ],
                    "category": "icon_manager_shape_group"
                },
                {
                    "key": "pixelparts_app_icons_launcher_remove_shape",
                    "title": "Remove Pixel Launcher icon background",
                    "description": "Remove the generated adaptive backing shape from launcher icons.",
                    "type": "switch",
                    "provider": "global",
                    "default": false,
                    "exclusiveWith": [
                        "pixelparts_app_icons_launcher_stretch_shape"
                    ],
                    "enabledIfAll": [
                        "pixelparts_app_icons_launcher_enabled"
                    ],
                    "category": "icon_manager_shape_group"
                },
                {
                    "key": "pixelparts_app_icons_launcher_shape_scale",
                    "title": "Pixel Launcher shape scale",
                    "description": "Adjust launcher icon mask size when a launcher shape override is active.",
                    "type": "float",
                    "provider": "global",
                    "default": 72,
                    "min": 0,
                    "max": 200,
                    "step": 1,
                    "unit": "%",
                    "enabledIfAny": [
                        "pixelparts_app_icons_launcher_stretch_shape",
                        "pixelparts_app_icons_launcher_remove_shape"
                    ],
                    "category": "icon_manager_shape_group"
                },
                {
                    "key": "pixelparts_app_icons_shape_background_tint_mode",
                    "title": "Background tinting",
                    "description": "Choose whether generated icon backgrounds use a fixed color or automatic tint.",
                    "type": "select",
                    "provider": "global",
                    "default": "0",
                    "options": [
                        {
                            "value": "0",
                            "label": "Off"
                        },
                        {
                            "value": "1",
                            "label": "Color"
                        },
                        {
                            "value": "2",
                            "label": "Auto"
                        }
                    ],
                    "category": "icon_manager_tint_group",
                    "categoryTitle": "Tinting",
                    "categoryDescription": "Background and foreground color for generated icons."
                },
                {
                    "key": "pixelparts_app_icons_shape_background_tint_color",
                    "title": "Background color",
                    "description": "ARGB color used when background tinting is set to Color.",
                    "type": "color",
                    "provider": "global",
                    "default": "#00000000",
                    "format": "hex_argb",
                    "alpha": true,
                    "enabledIfAll": [
                        "pixelparts_app_icons_shape_background_tint_mode=1"
                    ],
                    "category": "icon_manager_tint_group"
                },
                {
                    "key": "pixelparts_app_icons_shape_foreground_tint_mode",
                    "title": "Icon tinting",
                    "description": "Choose whether icon foregrounds use a fixed color or automatic tint.",
                    "type": "select",
                    "provider": "global",
                    "default": "0",
                    "options": [
                        {
                            "value": "0",
                            "label": "Off"
                        },
                        {
                            "value": "1",
                            "label": "Color"
                        },
                        {
                            "value": "2",
                            "label": "Auto"
                        }
                    ],
                    "category": "icon_manager_tint_group"
                },
                {
                    "key": "pixelparts_app_icons_shape_foreground_tint_color",
                    "title": "Icon color",
                    "description": "ARGB color used when icon tinting is set to Color.",
                    "type": "color",
                    "provider": "global",
                    "default": "#FFFFFFFF",
                    "format": "hex_argb",
                    "alpha": true,
                    "enabledIfAll": [
                        "pixelparts_app_icons_shape_foreground_tint_mode=1"
                    ],
                    "category": "icon_manager_tint_group"
                },
                {
                    "key": "pixelparts_icon_shape_workspace_match_all_apps",
                    "title": "Workspace shape matches All Apps",
                    "description": "Use the All Apps icon shape as the workspace shape source.",
                    "type": "switch",
                    "provider": "global",
                    "default": false,
                    "category": "icon_manager_all_apps_group",
                    "categoryTitle": "All Apps and per-app shapes",
                    "categoryDescription": "Workspace, All Apps, suggested icons and per-app shape overrides."
                },
                {
                    "key": "pixelparts_icon_shape_ignore_custom_settings",
                    "title": "Ignore per-app shapes",
                    "description": "Skip individual app shape overrides and use the shared shape rules.",
                    "type": "switch",
                    "provider": "global",
                    "default": false,
                    "category": "icon_manager_all_apps_group"
                },
                {
                    "key": "pixelparts_icon_shape_all_apps_follow_workspace",
                    "title": "All Apps follows the workspace",
                    "description": "Mirror workspace shape choices in the All Apps drawer.",
                    "type": "switch",
                    "provider": "global",
                    "default": false,
                    "category": "icon_manager_all_apps_group"
                },
                {
                    "key": "pixelparts_icon_shape_all_apps_themed_icons",
                    "title": "Themed icons in All Apps",
                    "description": "Apply themed icon rendering to the main All Apps list.",
                    "type": "switch",
                    "provider": "global",
                    "default": false,
                    "category": "icon_manager_all_apps_group"
                },
                {
                    "key": "pixelparts_icon_shape_all_apps_suggestions_themed_icons",
                    "title": "Themed icons in suggestions",
                    "description": "Apply themed icon rendering to suggested apps in All Apps.",
                    "type": "switch",
                    "provider": "global",
                    "default": false,
                    "category": "icon_manager_all_apps_group"
                }
            ]
        }
    ],

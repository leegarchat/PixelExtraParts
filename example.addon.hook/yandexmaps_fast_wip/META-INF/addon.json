                    "description": "Shows the refuel tab on the main screen (new and old tab-bar designs). Turn off to hide it.",
                    "type": "switch",
                    "provider": "global",
                    "default": true,
                    "category": "yandexmaps_fast_tabs",
                    "categoryTitle": "Tabs"
                },
                {

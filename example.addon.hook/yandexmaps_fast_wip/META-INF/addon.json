                    "description": "Keeps the taxi option offered on the single-route screen (SingleRouteType noTaxi flag). Turn off to hide taxi there.",
                    "type": "switch",
                    "provider": "global",
                    "default": true,
                    "category": "yandexmaps_fast_taxi",
                    "categoryTitle": "Taxi"
                },
                {
                    "key": "yandexmaps_taxi_car",

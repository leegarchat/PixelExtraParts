                    "provider": "global",
                    "default": true,
                    "category": "yandexmaps_fast_navi",
                    "categoryTitle": "Navigation"
                },
                {
                    "key": "yandexmaps_navi_refuel_settings",
                    "title": "Refuel in settings",

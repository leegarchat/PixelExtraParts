    "backgroundGradientSteps": [
        0,
        55,
        100
    ],
    "settings": [],
    "main": [
        {
            "id": "yandexmaps-fast",
            "title": "Yandex Maps Fast",
            "subtitle": "Render path and declutter",
            "icon": "Rounded.Map",
            "iconType": "app",
            "iconShape": "circle",
            "iconColor": "#FFDE59",
            "iconBackground": "#3E3424",
            "group": "apps",
            "priority": 50,
            "settings": [
                {
                    "key": "yandexmaps_vulkan_enabled",
                    "title": "Vulkan render",
                    "description": "Force the Vulkan render path instead of OpenGL. Fixes ~10s map load on blocklisted GPUs. Falls back to OpenGL automatically if Vulkan fails.",
                    "type": "switch",
                    "provider": "global",
                    "default": true,
                    "category": "yandexmaps_fast_render",
                    "categoryTitle": "Render path",
                    "categoryDescription": "Takes effect on next cold start of Yandex Maps."
                },
                {
                    "key": "yandexmaps_no_taxi",
                    "title": "Hide taxi button",
                    "description": "Removes the taxi price button from place cards.",
                    "type": "switch",
                    "provider": "global",
                    "default": true,
                    "category": "yandexmaps_fast_declutter",
                    "categoryTitle": "Declutter",
                    "categoryDescription": "Hides promo and ad UI."
                },
                {
                    "key": "yandexmaps_feed_mode",
                    "title": "Discovery feed",
                    "description": "Collapsed by default. var1: our anchor downgrade. var2: author-style content suppression. off: stock behavior.",
                    "type": "select",
                    "provider": "global",
                    "default": "var1",
                    "options": [
                        {
                            "value": "off",
                            "label": "Off"
                        },
                        {
                            "value": "var1",
                            "label": "var1 (ours)"
                        },
                        {
                            "value": "var2",
                            "label": "var2 (author)"
                        }
                    ],
                    "category": "yandexmaps_fast_declutter"
                },
                {
                    "key": "yandexmaps_disc_tab",
                    "title": "Discovery tab on main screen",
                    "description": "Hides the Discovery entry tab on the main screen (author-style tab gate).",
                    "type": "switch",
                    "provider": "global",
                    "default": true,
                    "category": "yandexmaps_fast_discovery",
                    "categoryTitle": "Discovery"
                },
                {
                    "key": "yandexmaps_disc_objects",
                    "title": "Discovery feed objects",
                    "description": "Empties the Discovery shutter items and filters lists (author-style content suppression).",
                    "type": "switch",
                    "provider": "global",
                    "default": true,
                    "category": "yandexmaps_fast_discovery",
                    "categoryTitle": "Discovery"
                },
                {
                    "key": "yandexmaps_disc_button",
                    "title": "Discovery shutter button",
                    "description": "Removes the map button from the Discovery shutter content (author-style).",
                    "type": "switch",
                    "provider": "global",
                    "default": true,
                    "category": "yandexmaps_fast_discovery",
                    "categoryTitle": "Discovery"

                    "description": "Removes the Plus upsell from the profile (menu icons and promo row).",
                    "type": "switch",
                    "provider": "global",
                    "default": true,
                    "category": "yandexmaps_fast_profile",
                    "categoryTitle": "Profile"
                },
                {
                    "key": "yandexmaps_prof_advertiser",
                    "title": "Advertiser in profile",
                    "description": "Disables the 'advertise your business' (PlaceAd) item in the profile carousel.",
                    "type": "switch",
                    "provider": "global",
                    "default": true,
                    "category": "yandexmaps_fast_profile",
                    "categoryTitle": "Profile"
                },
                {
                    "key": "yandexmaps_prof_company",
                    "title": "Company in profile",

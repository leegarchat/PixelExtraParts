                    "type": "switch",
                    "provider": "global",
                    "default": true,
                    "category": "yandexmaps_fast_search",
                    "categoryTitle": "Search"
                },
                {
                    "key": "yandexmaps_search_rubrics",
                    "title": "Luxury rubrics",
                    "description": "Shows premium rubric cards on the search start screen. Turn off to hide them.",
                    "type": "switch",
                    "provider": "global",
                    "default": true,
                    "category": "yandexmaps_fast_search",
                    "categoryTitle": "Search"
                },
                {
                    "key": "yandexmaps_prof_plus",

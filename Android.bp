
prebuilt_etc {
    name: "privapp_whitelist_org.pixel.customparts",
    sub_dir: "permissions",
    src: "privapp-permissions-pixelparts.xml",
    filename_from_src: true,
    system_ext_specific: true,
}


prebuilt_etc {
    name: "init.pixelextraparts.rc",
    src: "init.pixelextraparts.rc",
    sub_dir: "init",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "ambient_extend_hook_addon",
    src: "example.addon.hook/ambient_extend_hook/out/ambient_extend_hook.jar",
    sub_dir: "pixelparts/addons",
    filename_from_src: true,
    system_ext_specific: true,
}

prebuilt_etc {
    name: "settings_icon_style_override_addon",
    src: "example.addon.hook/settings_icon_style_override/out/settings_icon_style_override.jar",
    sub_dir: "pixelparts/addons",
    filename_from_src: true,
    system_ext_specific: true,
}

prebuilt_etc {
    name: "settings_homepage_item_addon",
    src: "example.addon.hook/settings_homepage_item/out/settings_homepage_item.jar",
    sub_dir: "pixelparts/addons",
    filename_from_src: true,
    system_ext_specific: true,
}

prebuilt_etc {
    name: "gcam_photo_torch_addon",
    src: "example.addon.hook/gcam_photo_torch/out/gcam_photo_torch.jar",
    sub_dir: "pixelparts/addons",
    filename_from_src: true,
    system_ext_specific: true,
}

prebuilt_etc {
    name: "launcher_hooks_addon",
    src: "example.addon.hook/launcher_hooks/out/launcher_hooks.jar",
    sub_dir: "pixelparts/addons",
    filename_from_src: true,
    system_ext_specific: true,
}

prebuilt_etc {
    name: "systemui_hooks_addon",
    src: "example.addon.hook/systemui_hooks/out/systemui_hooks.jar",
    sub_dir: "pixelparts/addons",
    filename_from_src: true,
    system_ext_specific: true,
}

prebuilt_etc {
    name: "icon_manager_settings_addon",
    src: "example.addon.hook/icon_manager_settings/out/icon_manager_settings.jar",
    sub_dir: "pixelparts/addons",
    filename_from_src: true,
    system_ext_specific: true,
}

prebuilt_etc {
    name: "ims_carrier_config_addon",
    src: "example.addon.hook/ims_carrier_config/out/ims_carrier_config.jar",
    sub_dir: "pixelparts/addons",
    filename_from_src: true,
    system_ext_specific: true,
}

java_import {
    name: "apksig-jar",
    jars: ["common/lib/apksig.jar"],
    sdk_version: "current",
}
cc_prebuilt_library_shared {
    name: "libaapt2_pixelparts", 
    stem: "libaapt2",
    
    // Явно указываем архитектуру, чтобы сборка не ломалась на эмуляторах и других таргетах
    arch: {
        arm64: {
            srcs: ["common/lib/arm64/libaapt2.so"],
        },
    },
    
    strip: {
        none: true,
    },
    check_elf_files: false,
    
    // Убрали installable: false и compile_multilib. 
    // Оставляем поведение по умолчанию.
}

android_app {
    name: "PixelCustomPartsSystem",

    manifest: "system/AndroidManifest.xml",
    resource_dirs: [
        "common/res"
    ],
    srcs: [
        "common/src/**/*.kt",
        "common/src/**/*.java",
        "system/src/**/*.kt",
        "system/src/**/*.java"
    ],
    use_embedded_native_libs: false,

    static_libs: [
        "apksig-jar",
        "androidx.core_core",
        "androidx.appcompat_appcompat",
        "com.google.android.material_material",
        "SettingsLib",
        "androidx.core_core-ktx",
        "androidx.activity_activity-compose",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-viewmodel-compose",
        "androidx.compose.runtime_runtime",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-tooling-preview",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-extended",
        "SettingsLib",
        "org.lineageos.settings.resources", 
    ],

    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    aaptflags: ["--custom-package", "org.pixel.customparts"],
    optimize: {
        enabled: true,
        proguard_flags_files: ["proguard.flags"],
    },
    required: [
        "privapp_whitelist_org.pixel.customparts",
        "init.pixelextraparts.rc",
        "aapt2_pixelparts"
    ],
}

// LSPlant backend: official core (LGPL-3.0,
// source https://github.com/LSPosed/LSPlant) + Dobby inline backend
// (Apache-2.0, https://github.com/jmpews/Dobby) + our JNI glue.
cc_prebuilt_library_shared {
    name: "liblsplant",
    srcs: ["lsplant/libs/lsplant/arm64-v8a/liblsplant.so"],
    strip: {
    none: true,
    },
    check_elf_files: false,
    system_ext_specific: false,
    installable: true,
}

cc_prebuilt_library_shared {
    name: "libdobby",
    srcs: ["lsplant/libs/lsplant/arm64-v8a/libdobby.so"],
    strip: {
    none: true,
    },
    check_elf_files: false,
    system_ext_specific: false,
    installable: true,
}

cc_prebuilt_library_shared {
    name: "libc++_shared",
    srcs: ["lsplant/libs/lsplant/arm64-v8a/libc++_shared.so"],
    strip: {
    none: true,
    },
    check_elf_files: false,
    system_ext_specific: false,
    installable: true,
}

cc_prebuilt_library_shared {
    name: "liblspbridge",
    srcs: ["lsplant/libs/lsplant/arm64-v8a/liblspbridge.so"],
    strip: {
    none: true,
    },
    check_elf_files: false,
    system_ext_specific: false,
    installable: true,
}


cc_prebuilt_binary {
    name: "aapt2_pixelparts",
    srcs: ["common/lib/arm64/libaapt2.so"],
    stem: "aapt2_pixelparts",
    system_ext_specific: true,
    strip: { none: true },
    check_elf_files: false,
}

java_library {
    name: "LsplantInject",
    // Xposed-compat shim over the LSPlant backend
    srcs: [
        // Общий интерфейс IHookEnvironment
        "lsplant/src/org/pixel/customparts/core/**/*.kt",
        "lsplant/src/org/pixel/customparts/core/**/*.java",
        // Общие хуки (код реализации)
        "lsplant/src/org/pixel/customparts/hooks/**/*.kt",
        "lsplant/src/org/pixel/customparts/hooks/**/*.java",
        // Менеджер инъекции (движок-независимый + LSPlant-бэкенд)
        "lsplant/src/org/pixel/customparts/manager/lsplant/**/*.kt",
        "lsplant/src/org/pixel/customparts/manager/lsplant/**/*.java",
        "lsplant/src/org/pixel/customparts/lsplantinject/**/*.kt",
        "lsplant/src/org/pixel/customparts/lsplantinject/**/*.java",
        // Xposed-совместимый слой поверх LSPlant
        "lsplant/src/de/robv/android/xposed/**/*.java",
        
        // Затенённый commons-lang для XposedHelpers
        "lsplant/src/external/org/apache/commons/lang3/**/*.java"
    ],
    installable: true,
    libs: [
        "framework",
    ],
    static_libs: [
        "kotlin-stdlib",
    ],
    kotlincflags: ["-Xjvm-default=all"],
}


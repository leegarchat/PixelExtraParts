
prebuilt_etc {
    name: "init.pixelextraparts.rc",
    src: "config/init.pixelextraparts.rc",
    sub_dir: "init",
    system_ext_specific: true,
}

// LSPlant backend: official core (LGPL-3.0,
// source https://github.com/LSPosed/LSPlant) + Dobby inline backend
// (Apache-2.0, https://github.com/jmpews/Dobby) + our JNI glue.
cc_prebuilt_library_shared {
    name: "liblsplant",
    srcs: ["native/lsplant/libs/lsplant/arm64-v8a/liblsplant.so"],
    strip: {
    none: true,
    },
    check_elf_files: false,
    system_ext_specific: false,
    installable: true,
}

cc_prebuilt_library_shared {
    name: "libdobby",
    srcs: ["native/lsplant/libs/lsplant/arm64-v8a/libdobby.so"],
    strip: {
    none: true,
    },
    check_elf_files: false,
    system_ext_specific: false,
    installable: true,
}

cc_prebuilt_library_shared {
    name: "libc++_shared",
    srcs: ["native/lsplant/libs/lsplant/arm64-v8a/libc++_shared.so"],
    strip: {
    none: true,
    },
    check_elf_files: false,
    system_ext_specific: false,
    installable: true,
}

cc_prebuilt_library_shared {
    name: "liblspbridge",
    srcs: ["native/lsplant/libs/lsplant/arm64-v8a/liblspbridge.so"],
    strip: {
    none: true,
    },
    check_elf_files: false,
    system_ext_specific: false,
    installable: true,
}


java_library {
    name: "LsplantInject",
    // Xposed-compat shim over the LSPlant backend
    srcs: [
        // Общий интерфейс IHookEnvironment
        "native/lsplant/src/org/pixel/customparts/core/**/*.kt",
        "native/lsplant/src/org/pixel/customparts/core/**/*.java",
        // Общие хуки (код реализации)
        "native/lsplant/src/org/pixel/customparts/hooks/**/*.kt",
        "native/lsplant/src/org/pixel/customparts/hooks/**/*.java",
        // Менеджер инъекции (движок-независимый + LSPlant-бэкенд)
        "native/lsplant/src/org/pixel/customparts/manager/lsplant/**/*.kt",
        "native/lsplant/src/org/pixel/customparts/manager/lsplant/**/*.java",
        "native/lsplant/src/org/pixel/customparts/lsplantinject/**/*.kt",
        "native/lsplant/src/org/pixel/customparts/lsplantinject/**/*.java",
        // Xposed-совместимый слой поверх LSPlant
        "native/lsplant/src/de/robv/android/xposed/**/*.java",
        // Modern Xposed API 101 (модули Vector/LSPosed-формата)
        "native/lsplant/src/io/github/libxposed/api/**/*.java",
        
        // Затенённый commons-lang для XposedHelpers
        "native/lsplant/src/external/org/apache/commons/lang3/**/*.java"
    ],
    installable: true,
    libs: [
        "framework",
    ],
    static_libs: [
        "kotlin-stdlib",
    ],
    kotlincflags: ["-Xjvm-default=all"],
}


// PixelExtraParts H1 weave overlays (replacements + helpers).
// Consumed by soong-pixelparts-plugin via Exclude_srcs/Srcs on
// framework-minus-apex and SettingsLib. No upstream .bp is touched.

// PixelExtraParts H1 weave: build-time generated sources (weave_gen/).
// Produced by weave/weave_apply.py from live vanilla + weave/specs
// during the make phase (see device.mk). Upstream trees stay vanilla.

filegroup {
    name: "pixelparts_weave_framework",
    srcs: [
        "weave_gen/frameworks/base/core/java/android/widget/EdgeEffect.java",
        "weave_gen/frameworks/base/core/java/android/widget/Magnifier.java",
        "weave_gen/frameworks/base/core/java/android/window/WindowOnBackInvokedDispatcher.java",
        "weave_gen/frameworks/base/core/java/android/app/Activity.java",
        "weave_gen/frameworks/base/core/java/android/app/ActivityThread.java",
        "weave_gen/frameworks/base/core/java/android/app/ApplicationPackageManager.java",
        "weave_gen/frameworks/base/core/java/android/content/pm/LauncherActivityInfo.java",
    ],
    visibility: ["//frameworks/base:__subpackages__"],
}

filegroup {
    name: "pixelparts_framework_helpers",
    srcs: [
        "platform/framework_helpers/core/java/**/*.java",
    ],
    visibility: ["//frameworks/base:__subpackages__"],
}

filegroup {
    name: "pixelparts_weave_settingslib",
    srcs: [
        "weave_gen/frameworks/base/packages/SettingsLib/src/com/android/settingslib/Utils.java",
    ],
    visibility: ["//frameworks/base/packages/SettingsLib:__subpackages__"],
}

filegroup {
    name: "pixelparts_weave_services_core",
    srcs: [
        "weave_gen/frameworks/base/services/core/java/com/android/server/pm/PackageInstallerService.java",
        "weave_gen/frameworks/base/services/core/java/com/android/server/pm/PackageInstallerSession.java",
        "weave_gen/frameworks/base/services/core/java/com/android/server/policy/PhoneWindowManager.java",
    ],
    visibility: ["//frameworks/base/services:__subpackages__"],
}

filegroup {
    name: "pixelparts_weave_services_impl",
    srcs: [
        "weave_gen/frameworks/base/services/core/java/com/android/server/wm/DisplayContent.java",
        "weave_gen/frameworks/base/services/java/com/android/server/SystemServer.java",
    ],
    visibility: ["//frameworks/base/services:__subpackages__"],
}

filegroup {
    name: "pixelparts_weave_thermal",
    srcs: [
        "weave_gen/hardware/google/pixel/thermal/service.cpp",
        "weave_gen/hardware/google/pixel/thermal/Thermal.cpp",
        "weave_gen/hardware/google/pixel/thermal/thermal-helper.cpp",
        "weave_gen/hardware/google/pixel/thermal/utils/thermal_throttling.cpp",
        "weave_gen/hardware/google/pixel/thermal/utils/thermal_info.cpp",
        "weave_gen/hardware/google/pixel/thermal/utils/thermal_files.cpp",
        "weave_gen/hardware/google/pixel/thermal/utils/power_files.cpp",
        "weave_gen/hardware/google/pixel/thermal/utils/powerhal_helper.cpp",
        "weave_gen/hardware/google/pixel/thermal/utils/thermal_stats_helper.cpp",
        "weave_gen/hardware/google/pixel/thermal/utils/thermal_predictions_helper.cpp",
        "weave_gen/hardware/google/pixel/thermal/utils/thermal_watcher.cpp",
        "weave_gen/hardware/google/pixel/thermal/virtualtemp_estimator/virtualtemp_estimator.cpp",
    ],
    visibility: ["//packages/apps/PixelExtraParts/native/thermal_hal"],
}

filegroup {
    name: "pixelparts_services_helpers",
    srcs: [
        "platform/services_helpers/**/*.java",
    ],
    visibility: ["//frameworks/base/services:__subpackages__"],
}
